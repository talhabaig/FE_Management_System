# Backend used by the Vite /api proxy in development (and documented for local setups).
# The browser always calls same-origin /api — do not point the app at a remote API URL directly
# or the refresh cookie will not survive a page reload.
VITE_API_URL=https://be-management-system.vercel.app

# Optional override for the Vite proxy target (defaults to VITE_API_URL, then localhost:3000)
# VITE_API_PROXY_TARGET=http://localhost:3000
